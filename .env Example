# 数据存储路径（必填）
WORKING_DIRECTORY = ./data/

# 配置目录路径（可选）
# 所有配置文件（agent_models.yaml、agents/、mcp.yaml）都相对于此目录。
# 默认为 config/
# 本地开发时使用 'config_local' 以避免 Git 追踪（已在 .gitignore 中）
CONFIG_DIRECTORY = config

# Conda 环境名称（可选 - 留空或设为 "none" 以跳过 conda）
# 项目会自动检测 conda 是否可用。如果未安装 conda，
# Python 代码将直接使用系统 Python 执行。
CONDA_ENV = datagen

# ChromeDriver 可执行文件路径（可选）
# webdriver-manager 可自动检测并下载正确版本的 ChromeDriver。
# 仅在需要固定路径时设置此项。
CHROMEDRIVER_PATH = ./chromedriver-linux64/chromedriver

# Firecrawl API 密钥（可选）
# 注意：如果缺少此密钥，查询功能可能会受限
FIRECRAWL_API_KEY = XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# === LLM API 密钥（至少需要一个）===
# DeepSeek：将您的 DeepSeek 密钥填入 OPENAI_API_KEY
#   （DeepSeek 使用与 OpenAI 兼容的 API 格式）
OPENAI_API_KEY = XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Anthropic API 密钥（可选）
ANTHROPIC_API_KEY = XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Google API 密钥（可选）
GOOGLE_API_KEY = XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# LangChain API 密钥（可选）
# 用于监控处理过程
LANGCHAIN_TRACING_V2 = true
LANGCHAIN_PROJECT = "Multi-agent-DataAnalysis"
LANGCHAIN_API_KEY = XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# MCP（模型上下文协议）设置（可选）
# 用于 web-search MCP 服务器的 Tavily API 密钥
TAVILY_API_KEY = XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# 用于 github MCP 服务器的 GitHub 令牌
GITHUB_TOKEN = XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
